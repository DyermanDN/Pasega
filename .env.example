# Configura estas dos variables en Vercel (Project Settings -> Environment Variables)
# Las encuentras en Supabase -> Project Settings -> API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-public-key

# Opcionales para emitir comprobantes reales a SUNAT vía Nubefact (sin ellas funciona en Modo Demo)
NUBEFACT_URL=https://api.nubefact.com/api/v1/TU-RUTA
NUBEFACT_TOKEN=tu-token-nubefact

# Opcional para consulta ilimitada de RUC/DNI (ej. apis.net.pe v2)
RUC_API_TOKEN=tu-token-consulta-ruc-dni
