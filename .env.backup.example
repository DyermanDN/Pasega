# Copia este archivo como ".env.backup" (NO se sube a GitHub)

# Conexión a tu proyecto en Supabase (HTTPS)
SUPABASE_URL=https://jrvrwankvqiskrtwklbw.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-supabase
PASEGA_EMAIL=admin@pasega.com
PASEGA_PASSWORD=tu-contraseña-del-panel

# Sincronización directa a tu PostgreSQL local (visible en pgAdmin 4)
LOCAL_PG_ENABLED=true
LOCAL_PG_HOST=localhost
LOCAL_PG_PORT=5432
LOCAL_PG_USER=postgres
LOCAL_PG_PASSWORD=TU_CONTRASEÑA_DE_PGADMIN
LOCAL_PG_DATABASE=pasega_backup

# Cantidad máxima de archivos .sql/.json recientes a conservar en /backups
BACKUP_KEEP_FILES=30
